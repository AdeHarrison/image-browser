sequenceDiagram
    autonumber
    participant Browser
    participant Ctrl as ImageController
    participant Cache as ImageCacheService
    participant Caffeine as Caffeine Cache<br/>(thumbnail or full-image)
    participant Repo as ImageRepository
    participant SQLite

    Browser->>Ctrl: GET /thumbnail/{id}  (or /image/{id}/bytes)
    Ctrl->>Cache: getThumbnail(id) / getFullImage(id)
    Cache->>Caffeine: get(id, loader)
    alt cache hit
        Caffeine-->>Cache: byte[] (no DB call)
    else cache miss
        Caffeine->>Repo: findThumbnailById(id) / findFullImageById(id)
        Repo->>SQLite: SELECT thumbnail / full_image FROM images WHERE id=?
        Repo-->>Caffeine: Optional~byte[]~
        Caffeine-->>Cache: byte[] (cached for next time)
    end
    alt found
        Cache-->>Ctrl: Optional.of(bytes)
        Ctrl-->>Browser: 200 OK, image/jpeg,<br/>Cache-Control: public, max-age=86400
    else not found
        Cache-->>Ctrl: Optional.empty()
        Ctrl-->>Browser: 404 Not Found
    end
