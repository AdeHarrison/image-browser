sequenceDiagram
    autonumber
    participant Spring as Spring Container
    participant DBInit as DatabaseInitialiser
    participant Repo as ImageRepository
    participant Import as SpreadsheetImportService
    participant Thumb as ThumbnailService
    participant Cache as ImageCacheService
    participant SQLite

    Spring->>DBInit: @PostConstruct initialise()
    DBInit->>Repo: createSchema()
    Repo->>SQLite: CREATE TABLE IF NOT EXISTS<br/>images, images_fts, image_meta, app_config

    DBInit->>Import: importIfUpdated()
    activate Import
    Import->>Import: read Metadata!A1 (readLastUpdated)
    Import->>Repo: getConfig("last_updated")
    Repo->>SQLite: SELECT value FROM app_config

    alt spreadsheet missing
        Import-->>DBInit: ImportResult.notFound
    else version unchanged (storedVersion present and not older)
        Import-->>DBInit: ImportResult.skipped
    else version changed / first run
        Import->>Repo: clearAll()
        Repo->>SQLite: delete-all FTS, image_meta, images, app_config row
        Import->>Cache: invalidateAll()
        loop for each sheet, each XSSFPicture
            Import->>Thumb: createThumbnail(fullBytes)
            Thumb-->>Import: thumbBytes (or empty if undecodable)
            Import->>Repo: insert(ImageRecord)
            Repo->>SQLite: INSERT images, image_meta, images_fts
        end
        Import->>Repo: setConfig("last_updated", newVersion)
        Import-->>DBInit: ImportResult.success(count, version)
    end
    deactivate Import

    Spring-->>Spring: ApplicationReadyEvent
    Spring->>Cache: schedulePreload()
    Cache->>Cache: preloadThumbnailsAsync() (@Async, new thread)
    activate Cache
    Cache->>Repo: findAllIds()
    loop for each id
        Cache->>Cache: thumbnailCache.get(id, loader)
        alt not cached
            Cache->>Repo: findThumbnailById(id)
            Repo->>SQLite: SELECT thumbnail
        end
    end
    Cache->>Cache: logStats()
    deactivate Cache
