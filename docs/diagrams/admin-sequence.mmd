sequenceDiagram
    autonumber
    participant Browser
    participant Ctrl as AdminController
    participant PwSvc as AdminPasswordService
    participant SessMgr as AdminSessionManager
    participant Import as SpreadsheetImportService

    Browser->>Ctrl: GET /admin/login
    alt already an active admin session for this browser
        Ctrl-->>Browser: redirect /admin
    else
        Ctrl-->>Browser: admin/login.html
    end

    Browser->>Ctrl: POST /admin/login (password)
    Ctrl->>PwSvc: verify(password)
    alt password incorrect
        PwSvc-->>Ctrl: false
        Ctrl-->>Browser: "Incorrect password."
    else
        Ctrl->>SessMgr: isAdminLoggedIn()
        alt another session already holds the lock
            SessMgr-->>Ctrl: true
            Ctrl-->>Browser: "Admin already logged in elsewhere."
        else
            Ctrl->>Browser: getSession(true) -> new HttpSession
            Ctrl->>SessMgr: login(sessionId)  [CAS null->sessionId]
            SessMgr-->>Ctrl: true
            Ctrl->>Ctrl: session.setAttribute("admin", true)
            Ctrl-->>Browser: <script>window.location='/admin'</script>
        end
    end

    Browser->>Ctrl: GET /admin
    Ctrl->>Ctrl: isAdmin()? (session attr + isActiveSession)
    Ctrl-->>Browser: admin/panel.html (or redirect /admin/login)

    Note over Browser: click "↺ Reload from Spreadsheet"
    Browser->>Ctrl: POST /admin/reload
    Ctrl->>Ctrl: isAdmin() check
    Ctrl->>Import: forceImport()
    Note right of Import: same import pipeline as startup,<br/>but unconditional (see import-flowchart)
    Import-->>Ctrl: ImportResult
    Ctrl-->>Browser: "✓ N images imported successfully." (or error)

    Note over Browser: click "Logout"
    Browser->>Ctrl: POST /admin/logout
    Ctrl->>SessMgr: logout(sessionId)  [CAS sessionId->null]
    Ctrl->>Ctrl: session.invalidate()
    Ctrl-->>Browser: redirect /
